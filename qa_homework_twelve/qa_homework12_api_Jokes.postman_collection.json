		{
			"name": "06) POST /jokes (dynamic) — conditional via writeMode",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const t = pm.variables.get('type') || 'general';",
							"const payload = { type: t, setup: 'PreReq setup ' + pm.variables.get('reqId'), punchline: 'PreReq punchline at ' + pm.variables.get('ts') };",
							"const raw = JSON.stringify(payload);",
							"pm.request.body.update(raw);",
							"pm.variables.set('payloadRaw', raw);",
							"pm.variables.set('bodyHash', CryptoJS.SHA256(raw).toString());"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const writeMode = (pm.variables.get('writeMode')||'public');",
							"const expectWrite = writeMode === 'local';",
							"pm.test('Pre-request set body', ()=> pm.expect(pm.request.body.raw).to.eql(pm.variables.get('payloadRaw')));",
							"pm.test('Computed bodyHash available', ()=> pm.expect(pm.variables.get('bodyHash')).to.be.a('string').and.not.empty);",
							"if (!expectWrite) {",
							"  pm.test('Public mode: POST blocked (404/405)', ()=> pm.expect([404,405]).to.include(pm.response.code));",
							"} else {",
							"  pm.test('Local mode: POST success (2xx)', ()=> pm.expect(pm.response.code).to.be.within(200,299));",
							"  try {",
							"    const json = pm.response.json();",
							"    pm.test('Response contains id', ()=> pm.expect(json).to.have.property('id'));",
							"    pm.test('Hash stable', ()=> pm.expect(CryptoJS.SHA256(pm.request.body.raw).toString()).to.eql(pm.variables.get('bodyHash')));",
							"  } catch(e) {}",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\"type\": \"{{type}}\", \"setup\": \"Example setup from Body tab\", \"punchline\": \"Example punchline from Body tab\"}"
				},
				"url": {
					"raw": "{{baseUrl}}/jokes",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"jokes"
					]
				}
			},
			"response": []
		},
		{
			"name": "07) PATCH /jokes/:id (dynamic) — conditional via writeMode",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const update = { punchline: 'Patched via prerequest ' + pm.variables.get('reqId') };",
							"const raw = JSON.stringify(update);",
							"pm.request.body.update(raw);",
							"pm.variables.set('patchRaw', raw);",
							"pm.variables.set('patchHash', CryptoJS.SHA256(raw).toString());"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const writeMode = (pm.variables.get('writeMode')||'public');",
							"const expectWrite = writeMode === 'local';",
							"pm.test('Pre-request set PATCH body', ()=> pm.expect(pm.request.body.raw).to.eql(pm.variables.get('patchRaw')));",
							"pm.test('PATCH body hash matches', ()=> pm.expect(CryptoJS.SHA256(pm.request.body.raw).toString()).to.eql(pm.variables.get('patchHash')));",
							"if (!expectWrite) {",
							"  pm.test('Public mode: PATCH blocked (404/405)', ()=> pm.expect([404,405]).to.include(pm.response.code));",
							"} else {",
							"  pm.test('Local mode: PATCH success (2xx)', ()=> pm.expect(pm.response.code).to.be.within(200,299));",
							"  try {",
							"    const json = pm.response.json();",
							"    pm.test('Punchline updated', ()=> pm.expect(json.punchline||'').to.eql(JSON.parse(pm.variables.get('patchRaw')).punchline));",
							"  } catch(e) {}",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\"punchline\": \"Example patched punchline from Body tab\"}"
				},
				"url": {
					"raw": "{{baseUrl}}/jokes/{{jokeId}}",
