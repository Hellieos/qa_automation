	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"const uuid = pm.variables.replaceIn('{{$randomUUID}}') || (Date.now().toString(16) + Math.random().toString(16).slice(2));",
					"pm.variables.set('reqId', uuid);",
					"pm.variables.set('ts', new Date().toISOString());",
					"if (!pm.variables.get('type')) { pm.variables.set('type', 'programming'); }",
					"pm.request.headers.upsert({ key: 'X-Request-Id', value: uuid });",
					"pm.request.headers.upsert({ key: 'X-Timestamp', value: pm.variables.get('ts') });"
				]
			}
		}
