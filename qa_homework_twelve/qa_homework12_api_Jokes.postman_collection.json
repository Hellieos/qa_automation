	"item": [
		{
			"name": "01) GET /random_joke (save id)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 200', () => pm.response.to.have.status(200));",
							"pm.test('Outgoing headers set by pre-request', () => {",
							"  pm.expect(pm.request.headers.get('X-Request-Id')).to.eql(pm.variables.get('reqId'));",
							"  pm.expect(pm.request.headers.get('X-Timestamp')).to.eql(pm.variables.get('ts'));",
							"});",
							"pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
							"pm.test('Response time < 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
							"const json = pm.response.json();",
							"const schema = { type: 'object', required: ['id','type','setup','punchline'], properties: { id:{type:'integer'}, type:{type:'string', minLength:1}, setup:{type:'string', minLength:1}, punchline:{type:'string', minLength:1} } };",
							"pm.test('Schema valid', () => pm.expect(tv4.validate(json, schema), tv4.error).to.be.true);",
							"pm.environment.set('jokeId', json.id);"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/random_joke",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"random_joke"
					]
				}
			},
			"response": []
		},
